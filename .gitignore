# ============================================================
# Agentic AI Systems — .gitignore
# ============================================================

# ---------------------------
# Environment & Secrets
# ---------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------
# Python
# ---------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ---------------------------
# Virtual Environments
# ---------------------------
.venv/
venv/
env/
ENV/
.env/
virtualenv/

# ---------------------------
# Jupyter Notebooks
# ---------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------------------------
# ML / Deep Learning
# ---------------------------
# Model weights & checkpoints
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.pkl
*.pickle
*.safetensors
checkpoints/
runs/
saved_models/
model_outputs/

# Datasets & large data files
data/raw/
data/processed/
data/interim/
data/external/
*.csv
*.parquet
*.feather
*.jsonl
*.arrow

# Logs & metrics
logs/
*.log
wandb/
mlruns/
.mlflow/
tensorboard_logs/
outputs/

# Vector stores / embeddings
*.faiss
*.index
chroma_db/
vector_store/

# ---------------------------
# LLM / API Caches
# ---------------------------
.cache/
cache/
*.cache

# ---------------------------
# IDE & Editor
# ---------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ---------------------------
# macOS
# ---------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ---------------------------
# Testing & Coverage
# ---------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover

# ---------------------------
# Misc
# ---------------------------
*.zip
*.tar.gz
*.rar
tmp/
temp/
scratch/

